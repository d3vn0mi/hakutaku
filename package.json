{
  "name": "hakutaku",
  "version": "0.0.0",
  "description": "Code intelligence for agents first, humans second.",
  "license": "MIT",
  "author": "d3vn0mi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d3vn0mi/hakutaku.git"
  },
  "type": "module",
  "bin": {
    "hakutaku": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    }
  },
  "files": [
    "dist",
    "python",
    "ast-grep",
    "engines.lock.json",
    "NOTICE",
    "THIRD_PARTY_LICENSES"
  ],
  "engines": {
    "node": ">=22.16"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-viewer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/viewer/app/tsconfig.json --noEmit && tsc -p test/e2e/tsconfig.json --noEmit",
    "lint": "biome check .",
    "test": "vitest run test/unit",
    "test:oracle": "vitest run test/oracle",
    "test:golden": "vitest run test/golden",
    "golden:update": "node test/golden/update.mjs",
    "test:hostile": "vitest run test/hostile",
    "test:mcp": "vitest run test/mcp",
    "test:e2e": "playwright test",
    "bench:viewer": "HAKUTAKU_BENCH=1 HAKUTAKU_E2E_WITH_SCALE=1 playwright test test/e2e/first-run.spec.ts test/e2e/performance.spec.ts --workers=1",
    "check:pack": "vitest run test/release/pack.test.ts",
    "check:licences": "vitest run test/release/licences.test.ts",
    "check:tree": "vitest run test/repo/tree.test.ts",
    "check:secrets": "vitest run test/repo/secrets.test.ts",
    "ci:local": "npm run build && npm run typecheck && npm run lint && npm test && npm run test:oracle && npm run test:golden && npm run test:hostile && npm run test:mcp && npm run test:e2e && npm run check:pack && npm run check:licences && npm run check:secrets && npm run check:tree"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.5",
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans-condensed": "2.0.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "graphology": "0.26.0",
    "highlight.js": "11.12.0",
    "sigma": "3.0.3",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "axe-core": "4.14.0",
    "vite": "7.3.7"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  }
}
